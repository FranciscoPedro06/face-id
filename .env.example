# Copie para .env (local) ou configure no painel do servidor (Railway, Render...).
# NUNCA commite o arquivo .env.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=coloque-a-chave-aqui
# Opcional: protege /cadastrar e /usuarios (enviar no header X-API-Key)
API_KEY=
# Opcional: sites que podem chamar a API, separados por vírgula
ALLOWED_ORIGINS=*
MAX_UPLOAD_MB=5
